[Database]
database=cabinpi
username=cabinpi
password=changeme

[Solar]
port=/dev/serial/by-id/usb-FTDI_USB_Serial_Converter_XXXXXXXX-if00-port0
#port=/dev/ttyUSB1

[Location]
latitude=0.0
longitude=0.0

[Images]
directory=/opt/images/

[Weather]
token=your-weatherflow-api-token
device=000000

[Inverter]
#port=/dev/ttyUSB0
port=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXXXXXX-if00-port0

[Notify]
method = email

# SMTP settings (can be Gmail, Outlook, etc.)
smtp_server = smtp.example.com
smtp_port = 465
smtp_user = user@example.com
# Either put app password in config (not recommended) or use environment variable
smtp_pass = changeme

# Notification details
from_addr = user@example.com
to_addr = recipient1@example.com,recipient2@example.com
# Optional: thresholds
battery_low_threshold = 12.0
battery_recovery_threshold = 12.8
alert_cooldown_minutes = 1440

[CloudflareD1]
# API token needs "D1:Edit" permission on the account
account_id=your-cf-account-id
database_id=your-d1-database-uuid
api_token=your-cf-api-token

[Reolink]
host=192.168.1.100
uid=your-camera-uid
username=admin
password=changeme
timeout=30

[CloudflareR2]
account_id=your-r2-account-id
access_key_id=your-r2-access-key-id
secret_access_key=your-r2-secret-access-key
bucket=your-bucket-name
#prefix=reolink
#endpoint=https://<account_id>.r2.cloudflarestorage.com
