# CabinPython v2 Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_PASSWORD=your_database_password_here

# Weather API
WEATHER_DEVICE=your_weatherflow_device_id
WEATHER_TOKEN=your_weatherflow_api_token

# Cloudflare Access
CF_API_URL=https://your-domain.com/api/sensors/ingest
CF_CLIENT_ID=your_cloudflare_client_id.access
CF_CLIENT_SECRET=your_cloudflare_client_secret

# SMTP Configuration for Email Alerts
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Alert Recipients (comma-separated)
ALERT_EMAIL_1=recipient1@example.com
ALERT_EMAIL_2=recipient2@example.com
